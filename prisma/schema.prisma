// Schema NanoPay - PostgreSQL
// Refonte alignee sur "NanoPay - Cahier de construction BACKEND" :
//  - commande centrale unique (Order) reliant Client, Commercant, Banque et Admin ;
//  - trois modes de financement : Epargne, Coffre (prelevement salaire), Credit ;
//  - statuts implementes exactement comme dans le cahier (section 3) ;
//  - montants en FCFA ENTIERS (Int), jamais de flottant (section 8).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------

enum UserRole {
  CLIENT
  MERCHANT
  BANK
  ADMIN
}

enum ClientStatus {
  ACTIF
  SUSPENDU
}

enum MerchantStatus {
  EN_ATTENTE
  VALIDE
  SUSPENDU
}

enum CreditProfileStatus {
  NON_CONFIGURE
  EN_ANALYSE
  VALIDE
  REFUSE
}

enum CreditRequestStatus {
  BROUILLON
  ENVOYEE
  EN_ANALYSE
  ACCEPTEE
  REFUSEE
}

enum CreditStatus {
  ACCEPTE
  EN_ATTENTE_DE_VIREMENT
  FINANCE
  TERMINE
}

enum SavingsStatus {
  EN_COURS
  PROLONGATION
  ATTEINTE
  ECHOUEE
  REMBOURSEE
}

enum VaultStatus {
  PROGRAMME
  PRELEVEMENT_EN_COURS
  OBJECTIF_ATTEINT
  UTILISE
  BASCULE_VERS_CREDIT
}

enum PaymentStatus {
  INITIE
  EN_ATTENTE
  CONFIRME
  ECHOUE
}

enum PaymentKind {
  SAVINGS_DEPOSIT
  VAULT_DEBIT
  SAVINGS_REFUND
  BANK_TRANSFER
  MERCHANT_PAYOUT
}

enum OrderStatus {
  CREEE
  FINANCEMENT_EN_COURS
  FINANCEE
  PRETE_A_LIVRER
  LIVREE
  TERMINEE
}

enum FinancingMode {
  SAVINGS
  VAULT
  CREDIT
}

enum QrStatus {
  GENERE
  UTILISE
  EXPIRE
}

enum SettlementStatus {
  EN_ATTENTE
  PAYE
}

enum PayoutChannel {
  ORANGE_MONEY
  CORIS_MONEY
  VIREMENT_BANCAIRE
}

enum MediaType {
  PHOTO
  SPOT_PUB
}

enum WebhookEventResult {
  APPLIED
  IGNORED
  REJECTED
}

// ------------------------------------------------------------------
// 1. IDENTITE & ACCES
// ------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  client        Client?
  merchant      Merchant?
  bank          Bank?
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  notifications Notification[]

  @@map("users")
}

model Client {
  id                 String       @id @default(uuid())
  userId             String       @unique @map("user_id")
  firstName          String       @map("first_name")
  lastName           String       @map("last_name")
  phoneNumber        String       @map("phone_number")
  cnibRectoUrl       String       @map("cnib_recto_url")
  cnibVersoUrl       String       @map("cnib_verso_url")
  cityId             String?      @map("city_id")
  communeId          String?      @map("commune_id")
  status             ClientStatus @default(ACTIF)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  city          City?          @relation(fields: [cityId], references: [id])
  commune       Commune?       @relation(fields: [communeId], references: [id])
  orders        Order[]
  creditProfile CreditProfile?
  creditRequests CreditRequest[]

  @@map("clients")
}

model Merchant {
  id                String         @id @default(uuid())
  userId            String         @unique @map("user_id")
  firstName         String         @map("first_name")
  lastName          String         @map("last_name")
  cnibRectoUrl      String         @map("cnib_recto_url")
  cnibVersoUrl      String         @map("cnib_verso_url")
  ifuRccmNumber     String         @map("ifu_rccm_number")
  orangeMoneyNumber String?        @map("orange_money_number")
  corisMoneyNumber  String?        @map("coris_money_number")
  defaultPayoutChannel PayoutChannel @map("default_payout_channel")
  status            MerchantStatus @default(EN_ATTENTE)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  store       Store?
  withdrawals Withdrawal[]
  settlements MerchantSettlement[]

  @@map("merchants")
}

model Bank {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditProfiles CreditProfile[]
  creditRequests CreditRequest[]

  @@map("banks")
}

// ------------------------------------------------------------------
// 2. MARKETPLACE
// ------------------------------------------------------------------

model City {
  id   String @id @default(uuid())
  name String @unique

  communes Commune[]
  stores   Store[]
  clients  Client[]

  @@map("cities")
}

model Commune {
  id     String @id @default(uuid())
  cityId String @map("city_id")
  name   String

  city    City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  stores  Store[]
  clients Client[]

  @@unique([cityId, name])
  @@map("communes")
}

model Store {
  id                 String   @id @default(uuid())
  // Un commercant gere une seule boutique.
  merchantId         String   @unique @map("merchant_id")
  name               String
  cityId             String   @map("city_id")
  communeId          String   @map("commune_id")
  addressDescription String?  @map("address_description")
  createdAt          DateTime @default(now()) @map("created_at")

  merchant Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  city     City      @relation(fields: [cityId], references: [id])
  commune  Commune   @relation(fields: [communeId], references: [id])
  products Product[]
  orders   Order[]

  @@index([cityId, communeId])
  @@map("stores")
}

model Product {
  id          String    @id @default(uuid())
  storeId     String    @map("store_id")
  title       String
  description String?
  // FCFA entier. Prix publie definitif : non modifiable apres creation (cahier, section 6).
  price       Int
  stock       Int
  isPublished Boolean   @default(true) @map("is_published")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  store  Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  media  ProductMedia[]
  orders Order[]

  @@index([storeId])
  @@map("products")
}

model ProductMedia {
  id        String    @id @default(uuid())
  productId String    @map("product_id")
  mediaUrl  String    @map("media_url")
  mediaType MediaType @map("media_type")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_media")
}

// ------------------------------------------------------------------
// 3. COMMANDE CENTRALE
// ------------------------------------------------------------------

model Order {
  id            String         @id @default(uuid())
  // Identifiant lisible pour l'UI (ex. NP-2026-00001245), derive de orderSeq.
  orderNumber   String         @unique @map("order_number")
  orderSeq      Int            @unique @default(autoincrement()) @map("order_seq")
  clientId      String         @map("client_id")
  productId     String         @map("product_id")
  storeId       String         @map("store_id")
  amount        Int
  financingMode FinancingMode? @map("financing_mode")
  status        OrderStatus    @default(CREEE)
  cancelledAt   DateTime?      @map("cancelled_at")
  cancelReason  String?        @map("cancel_reason")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  client        Client              @relation(fields: [clientId], references: [id])
  product       Product             @relation(fields: [productId], references: [id])
  store         Store               @relation(fields: [storeId], references: [id])
  savings       Savings?
  vault         Vault?
  creditRequest CreditRequest?
  credit        Credit?
  payments      Payment[]
  qrTokens      QRToken[]
  withdrawal    Withdrawal?
  settlement    MerchantSettlement?

  @@index([clientId])
  @@index([storeId])
  @@map("orders")
}

// ------------------------------------------------------------------
// 4. FINANCEMENTS
// ------------------------------------------------------------------

model Savings {
  id               String        @id @default(uuid())
  orderId          String        @unique @map("order_id")
  targetAmount     Int           @map("target_amount")
  savedAmount      Int           @default(0) @map("saved_amount")
  minInstallment   Int           @map("min_installment")
  durationMonths   Int           @map("duration_months")
  extensionMonths  Int           @default(0) @map("extension_months")
  // Date de depart = premier versement effectivement recu et valide (cahier, section 6).
  startedAt        DateTime?     @map("started_at")
  dueDate          DateTime?     @map("due_date")
  status           SavingsStatus @default(EN_COURS)
  penaltyAmount    Int           @default(0) @map("penalty_amount")
  refundAmount     Int           @default(0) @map("refund_amount")
  createdAt        DateTime      @default(now()) @map("created_at")

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@map("savings")
}

model Vault {
  id                       String      @id @default(uuid())
  orderId                  String      @unique @map("order_id")
  targetAmount             Int         @map("target_amount")
  collectedAmount          Int         @default(0) @map("collected_amount")
  monthlyAmount            Int         @map("monthly_amount")
  durationMonths           Int         @map("duration_months")
  salaryDebitAuthorizationUrl String?  @map("salary_debit_authorization_url")
  status                   VaultStatus @default(PROGRAMME)
  createdAt                DateTime    @default(now()) @map("created_at")

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@map("vaults")
}

model CreditProfile {
  id                   String              @id @default(uuid())
  clientId             String              @unique @map("client_id")
  bankId               String?             @map("bank_id")
  employer             String?
  registrationNumber   String?             @map("registration_number")
  bankAuthorizationUrl String?             @map("bank_authorization_url")
  paySlipsUrl          String?             @map("pay_slips_url")
  status               CreditProfileStatus @default(NON_CONFIGURE)
  decisionReason       String?             @map("decision_reason")
  decidedAt            DateTime?           @map("decided_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  bank   Bank?  @relation(fields: [bankId], references: [id])

  @@map("credit_profiles")
}

model CreditRequest {
  id                 String              @id @default(uuid())
  orderId            String              @unique @map("order_id")
  clientId           String              @map("client_id")
  bankId             String              @map("bank_id")
  amount             Int
  durationMonths     Int                 @map("duration_months")
  monthlyInstallment Int                 @map("monthly_installment")
  bankFeeAmount      Int                 @map("bank_fee_amount")
  totalAmountToWire  Int                 @map("total_amount_to_wire")
  status             CreditRequestStatus @default(ENVOYEE)
  decisionReason     String?             @map("decision_reason")
  decidedAt          DateTime?           @map("decided_at")
  createdAt          DateTime            @default(now()) @map("created_at")

  order  Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  client Client  @relation(fields: [clientId], references: [id])
  bank   Bank    @relation(fields: [bankId], references: [id])
  credit Credit?

  @@map("credit_requests")
}

model Credit {
  id                 String       @id @default(uuid())
  creditRequestId    String       @unique @map("credit_request_id")
  orderId            String       @unique @map("order_id")
  amount             Int
  durationMonths     Int          @map("duration_months")
  monthlyInstallment Int          @map("monthly_installment")
  totalAmountToWire  Int          @map("total_amount_to_wire")
  status             CreditStatus @default(ACCEPTE)
  transferReference  String?      @map("transfer_reference")
  transferNotedAt    DateTime?    @map("transfer_noted_at")
  createdAt          DateTime     @default(now()) @map("created_at")

  creditRequest CreditRequest @relation(fields: [creditRequestId], references: [id], onDelete: Cascade)
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("credits")
}

// ------------------------------------------------------------------
// 5. PAIEMENTS & WEBHOOKS
// ------------------------------------------------------------------

model Payment {
  id                    String        @id @default(uuid())
  orderId               String        @map("order_id")
  savingsId             String?       @map("savings_id")
  vaultId               String?       @map("vault_id")
  kind                  PaymentKind
  amount                Int
  currency              String        @default("XOF")
  provider              String?
  // Contrainte UNIQUE : une meme transaction n'est jamais comptabilisee deux fois.
  providerTransactionId String?       @unique @map("provider_transaction_id")
  payerReference        String?       @map("payer_reference")
  status                PaymentStatus @default(INITIE)
  createdAt             DateTime      @default(now()) @map("created_at")
  confirmedAt           DateTime?     @map("confirmed_at")

  order   Order    @relation(fields: [orderId], references: [id])
  savings Savings? @relation(fields: [savingsId], references: [id])
  vault   Vault?   @relation(fields: [vaultId], references: [id])

  @@index([orderId])
  @@map("payments")
}

model PaymentEvent {
  id                    String             @id @default(uuid())
  providerTransactionId String             @unique @map("provider_transaction_id")
  orderId               String?            @map("order_id")
  amount                Int
  currency              String
  status                String
  payload               Json
  result                WebhookEventResult
  reason                String?
  receivedAt            DateTime           @default(now()) @map("received_at")

  @@map("payment_events")
}

// ------------------------------------------------------------------
// 6. QR, RETRAIT, REGLEMENT COMMERCANT
// ------------------------------------------------------------------

model QRToken {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  // Jeton opaque genere cote serveur ; aucune donnee metier n'est encodee dedans.
  token     String   @unique
  status    QrStatus @default(GENERE)
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("qr_tokens")
}

model Withdrawal {
  id          String   @id @default(uuid())
  orderId     String   @unique @map("order_id")
  merchantId  String   @map("merchant_id")
  qrTokenId   String   @map("qr_token_id")
  confirmedAt DateTime @default(now()) @map("confirmed_at")

  order    Order    @relation(fields: [orderId], references: [id])
  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@map("withdrawals")
}

model MerchantSettlement {
  id             String           @id @default(uuid())
  orderId        String           @unique @map("order_id")
  merchantId     String           @map("merchant_id")
  grossAmount    Int              @map("gross_amount")
  commissionRate Decimal          @map("commission_rate") @db.Decimal(6, 4)
  commissionAmount Int            @map("commission_amount")
  netAmount      Int              @map("net_amount")
  channel        PayoutChannel
  payoutReference String?         @map("payout_reference")
  status         SettlementStatus @default(EN_ATTENTE)
  createdAt      DateTime         @default(now()) @map("created_at")
  paidAt         DateTime?        @map("paid_at")

  order    Order    @relation(fields: [orderId], references: [id])
  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@map("merchant_settlements")
}

// ------------------------------------------------------------------
// 7. TRANSVERSE : notifications, audit, parametres, technique
// ------------------------------------------------------------------

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

// Trace : date/heure (createdAt), identifiant, acteur, montant et statut (cahier, section 7).
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  actorRole  String?  @map("actor_role")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  amount     Int?
  status     String?
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Parametres financiers modifiables depuis le back-office (formules 4 %, 20 %, 15 %...).
model Setting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model IdempotencyKey {
  id           String   @id @default(uuid())
  key          String   @unique
  scope        String
  responseBody Json?    @map("response_body")
  statusCode   Int?     @map("status_code")
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")

  @@map("idempotency_keys")
}
