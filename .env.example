# Application
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000

# CORS : domaine(s) du frontend, separes par des virgules ("*" = tout, developpement uniquement)
CORS_ORIGIN=http://localhost:5173

# Base de donnees (PostgreSQL)
DATABASE_URL="postgresql://nanapay:nanapay@localhost:5432/nanapay_db?schema=public"

# Authentification
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Mot de passe
BCRYPT_SALT_ROUNDS=12

# Fichiers
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# E-mail (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@nanapay.com
SMTP_PASS=change_me
SMTP_FROM="NanaPay <no-reply@nanapay.com>"

# Webhook de paiement Mobile Money : POST /api/webhooks/payment
# Secret HMAC-SHA256 partage avec l'infrastructure Mobile Money (en-tete X-Signature).
# Genere une valeur longue et aleatoire ; obligatoire en production.
PAYMENT_WEBHOOK_SECRET=
MOBILE_MONEY_BASE_URL=
MOBILE_MONEY_API_KEY=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_AUTH=10
RATE_LIMIT_MAX_SENSITIVE=30
RATE_LIMIT_MAX_WEBHOOK=120
